{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cp-reminders",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "triggers": { "crons": ["*/5 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cp-reminders",
      "database_id": "27151c8f-c41c-47e8-b60b-250ebf43cfad",
      "migrations_dir": "migrations"
    }
  ],
  "vars": { "GH_REPO": "adityakotkar47/cp-reminders" },
  "secrets": {
    "required": ["CLIST_USERNAME", "CLIST_API_KEY", "GH_TOKEN", "TICK_TOKEN", "ADMIN_TOKEN", "SENDER_TOKEN"]
  },
  "observability": { "enabled": true },
  "minify": true
}
